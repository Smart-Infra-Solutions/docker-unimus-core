# Stage 1: Download and verify Unimus Core binary
FROM debian:stable-slim@sha256:a64d9dbf633e2a2503afac76be521dc25d9b5765150b30d31a3914d4ae969cab AS downloader

# Set Unimus latest download url
ENV DOWNLOAD_URL=https://download.unimus.net/unimus-core/-%20Latest/Unimus-Core.jar

# Optional: Set expected SHA256 checksum for JAR verification
ARG JAR_SHA256="409963d0c68e6838a8acd770f2bae2ec280da73ea66a05cf011f456d91489fee"

# Download and verify Unimus Core JAR
RUN apt-get update && \
    apt-get install -y curl && \
    curl -L -o /tmp/unimus-core.jar $DOWNLOAD_URL && \
    if [ ! -z "$JAR_SHA256" ]; then \
        echo "$JAR_SHA256  /tmp/unimus-core.jar" | sha256sum -c - || { echo "Checksum verification failed!"; exit 1; }; \
        echo "JAR checksum verified successfully"; \
    else \
        echo "Warning: Skipping checksum verification (JAR_SHA256 not set)"; \
    fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Stage 2: Final runtime image
FROM debian:stable-slim@sha256:a64d9dbf633e2a2503afac76be521dc25d9b5765150b30d31a3914d4ae969cab

# Link the image to its source repository (GitHub Container Registry)
LABEL org.opencontainers.image.source=https://github.com/Smart-Infra-Solutions/docker-unimus-core

# Install runtime dependencies only
RUN apt-get update && \
    apt-get install -y tini less tzdata openjdk-25-jre-headless procps && \
    apt-get clean && \
    apt-get autoremove --yes && \
    rm -rf /var/lib/{apt,dpkg,cache,log}/

# Copy Unimus Core binary from downloader stage
COPY --from=downloader /tmp/unimus-core.jar /opt/unimus-core.jar

# Copy start script
COPY files/start.sh /opt/start.sh

# Set script permissions
RUN chmod +x /opt/start.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "unimus-core.jar" || exit 1

# Entrypoint
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/opt/start.sh"]
